#include <behaviors.dtsi>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define NUM 1
#define FUN 2
#define SYS 3

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 /* left hand  */
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 /* right hand */
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      /* thumbs     */

// ---------- SETTINGS ----------

&sk {  // sticky-key config
    release-after-ms = <1000>; // release after 1s
    quick-release;             // no double capitalization when rolling keys
};

&sl {  // sticky-layer config
    ignore-modifiers;          // allow chording sticky mods & layers
};

&lt {  // layer-tap config
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

// ----------- COMBOS -----------
#undef COMBO_HOOK
#define COMBO_HOOK require-prior-idle-ms = <150>;
#define COMBO_TERM_FAST 25
#define COMBO_TERM_SLOW 50

// left and right bracket [ ]
ZMK_COMBO(lbkt, &kp LBKT, LT2 LT3, DEF NUM, COMBO_TERM_FAST)
ZMK_COMBO(rbkt, &kp RBKT, LT1 LT2, DEF NUM, COMBO_TERM_FAST)

// left and right right brace { }
ZMK_COMBO(lbrc, &kp LBRC, LM2 LM3, DEF NUM, COMBO_TERM_FAST)
ZMK_COMBO(rbrc, &kp RBRC, LM1 LM2, DEF NUM, COMBO_TERM_FAST)

// left and right less-then and greater-then < >
ZMK_COMBO(lt, &kp LT, LB2 LB3, DEF, COMBO_TERM_FAST)
ZMK_COMBO(gt, &kp GT, LB1 LB2, DEF, COMBO_TERM_FAST)

// dash and underscore - _ 
ZMK_COMBO(minus, &kp MINUS, RB1 RB2, DEF NUM, COMBO_TERM_FAST)
ZMK_COMBO(under, &kp UNDER, RB2 RB3, DEF NUM, COMBO_TERM_FAST)

// mac jump left and right 1 word
ZMK_COMBO(workspace_left,  &kp LA(LEFT),  RM3 RM2, NUM FUN, COMBO_TERM_FAST)
ZMK_COMBO(workspace_right, &kp LA(RIGHT), RM2 RM1, NUM FUN, COMBO_TERM_FAST)

// slash and backslash
ZMK_COMBO(bksl, &kp BACKSLASH, RT3 RT2, DEF NUM, COMBO_TERM_FAST)
ZMK_COMBO(sl, &kp SLASH, RT2 RT1, DEF NUM, COMBO_TERM_FAST)

// ? and "
ZMK_COMBO(question, &kp QUESTION, RT1 RT0, DEF NUM, COMBO_TERM_FAST)
ZMK_COMBO(dqt, &kp DQT, RM1 RM0, DEF NUM, COMBO_TERM_FAST)

// symbols on vert
ZMK_COMBO(excl, &kp EXCL, LT4 LM4, DEF, COMBO_TERM_FAST)
ZMK_COMBO(at, &kp AT, LT3 LM3, DEF, COMBO_TERM_FAST)
ZMK_COMBO(hash, &kp HASH, LT2 LM2, DEF, COMBO_TERM_FAST)
ZMK_COMBO(dollar, &kp DOLLAR, LT1 LM1, DEF, COMBO_TERM_FAST)
ZMK_COMBO(perc, &kp PERCENT, LT0 LM0, DEF, COMBO_TERM_FAST)

ZMK_COMBO(caret, &kp CARET, RT0 RM0, DEF, COMBO_TERM_FAST)
ZMK_COMBO(amper, &kp AMPERSAND, RT1 RM1, DEF, COMBO_TERM_FAST)
ZMK_COMBO(ast, &kp KP_ASTERISK, RT2 RM2, DEF, COMBO_TERM_FAST)
ZMK_COMBO(lpar, &kp LPAR, RT3 RM3, DEF, COMBO_TERM_FAST)
ZMK_COMBO(rpar, &kp RPAR, RT4 RM4, DEF, COMBO_TERM_FAST)

//ZMK_BEHAVIOR(larr, macro,
//    wait-ms = <0>;
//    tap-ms = <5>;
//    bindings = <&kp LALT &kp LEFT>;
//)
//ZMK_BEHAVIOR(rarr, macro,
