//ZMK_COMBO(left_arrow,  &larr, RM2 RM1, DEF NUM, COMBO_TERM_FAST)
//ZMK_COMBO(right_arrow, &rarr, RM3 RM2, DEF NUM, COMBO_TERM_FAST)

// ----------- KEYMAP -----------

// Cross-hand only home row mods
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs

// tap: sticky shift | shift + tap or double-tap: caps word | hold: num (unused)
//#define smart_shift smart_shift_inner NUM 0
//ZMK_BEHAVIOR(smart_shift_inner, hold_tap,
//    flavor = "balanced";
//    tapping-term-ms = <200>;
//    quick-tap-ms = <QUICK_TAP_MS>;
//    bindings = <&mo>, <&shift_word>;
//)
ZMK_BEHAVIOR(shift_word, mod_morph,
    bindings = <&sk LSHFT>, <&caps_word>;
    mods = <MOD_LSFT>;
)

// tap: backspace | lshft + tap: delete
ZMK_BEHAVIOR(bs_del, mod_morph,
    bindings = <&kp BSPC>, <&kp DEL>;
    mods = <MOD_LSFT>;
    /* keep-mods = <MOD_RSFT>; */
)

// reuse basic mod-morph scheme
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_BEHAVIOR(NAME, mod_morph, \
        mods = <(MOD_L ## MOD|MOD_R ## MOD)>; \
        bindings = <BINDING1>, <BINDING2>; \
    )

// tap: colon | shift + tap: semicolon
SIMPLE_MORPH(colon_semi, SFT, &kp COLON, &kp SEMI)

// tap: apos | shift + tap: quote
//SIMPLE_MORPH(apos_quote, SFT, &kp APOS, &kp DQT)

// tap: plus | shift + tap: equal
//SIMPLE_MORPH(plus_equal, SFT, &kp PLUS, &kp EQUAL)

// tap: space | shift + tap: dot -> space -> sticky shift | hold: space
SIMPLE_MORPH(smart_space, SFT, &kp SPACE, &dot_space)
ZMK_BEHAVIOR(dot_space, macro,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOT &kp SPACE &sk LSHFT>;
)

// tap: TAB | control + tap: TILDE | control + shift + tap: GRAVE | hold: func layer
#define smart_tab smart_tab_inner FUN 0
ZMK_BEHAVIOR(smart_tab_inner, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo>, <&tab_tilde_grave>;
)
SIMPLE_MORPH(tab_tilde_grave, CTL, &kp TAB, &tilde_grave)
SIMPLE_MORPH(tilde_grave, SFT, &kp TILDE, &tilde_grave_inner)
ZMK_BEHAVIOR(tilde_grave_inner, mod_morph,
    mods = <(MOD_LSFT|MOD_LCTL)>; // need to clear the outer mods
    bindings = <&kp GRAVE>, <&kp GRAVE>;
)

// double-tap to enter bootloader
ZMK_BEHAVIOR(boot, tap_dance,
    bindings = <&none>, <&bootloader>;
)

ZMK_CONDITIONAL_LAYER(SYS,NUM FUN, SYS)

ZMK_LAYER(base,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &hml LCTRL A   &hml LALT S  &hml LGUI D  &hml LSHFT F     &kp G             &kp H       &hmr RSHFT J  &hmr RGUI K   &hmr RALT L   &hmr RCTRL APOS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N         &kp M       &kp COMMA      &kp DOT     &colon_semi
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp ESC     &shift_word   &smart_space        &bs_del    &lt NUM ENTER   &smart_tab
//                                 esc        shft/caps/NUM  space/period       back/del    &lt NUM/ENTER   tab/tilde/grave/FUN
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
) 

ZMK_LAYER(numpad,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp KP_DOT     &kp N7        &kp N8        &kp N9       &kp PLUS          &kp K_COPY    &kp K_CUT      &kp UP      &kp K_PASTE     XXX  
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp SLASH      &kp N4        &kp N5        &kp N6       &kp MINUS         &kp K_UNDO    &kp LEFT      &kp DOWN      &kp RIGHT      XXX
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp DOT       &kp N1        &kp N2        &kp N3       &kp EQUAL         &kp K_REDO     &kp PG_UP    &kp PG_DN       XXX         XXX
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp N0      &kp ENTER      &kp BSPC          ___           ___              ___
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Function,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp PG_UP     &kp HOME       &kp UP        &kp END         XXX                XXX           XXX           XXX           XXX           XXX
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp PG_DN     &kp LEFT      &kp DOWN      &kp RIGHT        XXX               XXX           XXX           XXX           XXX           XXX
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX           XXX           XXX           XXX           XXX                XXX           XXX           XXX           XXX           XXX
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                     XXX           XXX           ___               ___           XXX           XXX
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(System,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &boot       &bt BT_PRV    &kp C_PREV   &kp C_VOL_UP  &kp C_BRI_INC         XXX       &kp F7         &kp F8       &kp F9        &kp F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX        &bt BT_CLR    &kp C_PP     &kp C_MUTE    &kp C_BRI_DEC         XXX       &kp F4         &kp F5       &kp F6        &kp F11
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX        &bt BT_NXT    &kp C_NEXT   &kp C_VOL_DN     XXX                XXX       &kp F1         &kp F2       &kp F3        &kp F10
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                     XXX           XXX           ___               ___           XXX           XXX
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

